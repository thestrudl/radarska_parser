# --- Database ---
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar_password
POSTGRES_DB=radar
# Host/port as seen from the api & ingestor containers (service name "db")
DB_HOST=db
DB_PORT=5432

# --- Ingestion ---
# Minutes between radar/weather polls
INGEST_INTERVAL_MINUTES=10
# Downsample factor: 1 grid cell = N x N source pixels (higher = coarser, less storage)
GRID_CELL_PIXELS=4

# --- External sources ---
RADAR_IMAGE_URL=https://meteo.arso.gov.si/uploads/probase/www/observ/radar/si0-rm.gif
WEATHER_XML_URL=https://meteo.arso.gov.si/uploads/probase/www/observ/surface/text/sl/observation_si_latest.xml

# --- Storage ---
# Where archived radar frames (gif + npy) are written inside the container
FRAMES_DIR=/data/frames

# --- Geocoding ---
NOMINATIM_USER_AGENT=radarska-parser
